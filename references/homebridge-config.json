          "rejectUnauthorized": true,
          "on_url": "http://localhost:3689/api/player/play",
          "on_method": "PUT",
          "on_body": "{}",
          "on_headers": "{\"Content-Type\": \"application/json\"}",
          "off_url": "http://localhost:3689/api/player/stop",
          "off_method": "PUT",
          "off_body": "{}",
          "off_headers": "{\"Content-Type\": \"application/json\"}"
        }
      ]
    }
  ],
  "accessories": []
