#!/usr/bin/env bash
# Smart volume control: HomePod when it's default sink, otherwise system volume
# Uses swayosd-client for OSD notifications (Omarchy default)

HOMEPOD_SINK="homepod_airplay"
DEFAULT_SINK=$(pactl get-default-sink)

notify_volume() {
    local action="$1"
    swayosd-client --output-volume "$action" 2>/dev/null || true
}

case "${1:-}" in
    up)
        if [ "$DEFAULT_SINK" = "$HOMEPOD_SINK" ]; then
            ~/.local/bin/homepod-volume up
        else
            wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
            notify_volume raise
        fi
        ;;
    down)
        if [ "$DEFAULT_SINK" = "$HOMEPOD_SINK" ]; then
            ~/.local/bin/homepod-volume down
        else
            wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
            notify_volume lower
        fi
        ;;
    mute)
        if [ "$DEFAULT_SINK" = "$HOMEPOD_SINK" ]; then
            ~/.local/bin/homepod-volume mute
        else
            wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
            notify_volume mute-toggle
        fi
        ;;
    *)
        echo "Usage: $0 {up|down|mute}"
        exit 1
        ;;
esac