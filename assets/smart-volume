#!/usr/bin/env bash
# Smart volume control: HomePod when it's default sink, otherwise system volume

HOMEPOD_SINK="homepod_airplay"
DEFAULT_SINK=$(pactl get-default-sink)

notify_volume() {
    local vol="$1"
    local muted="$2"
    local icon="audio-volume-high"
    if [ "$muted" = "true" ] || [ "${vol:-0}" = "0" ]; then
        icon="audio-volume-muted"
    else
        # Convert to percentage for comparison
        local pct=$(echo "$vol * 100" | awk '{print int($1)}')
        if (( pct < 33 )); then
            icon="audio-volume-low"
        elif (( pct < 66 )); then
            icon="audio-volume-medium"
        fi
    fi
    local percent=$(echo "$vol * 100" | awk '{print int($1)}')
    notify-send -i "$icon" -h int:value:"$percent" -h string:x-canonical-private-synchronous:volume "Volumen: ${percent}%" -t 1000 2>/dev/null || true
}

case "${1:-}" in
    up)
        if [ "$DEFAULT_SINK" = "$HOMEPOD_SINK" ]; then
            ~/.local/bin/homepod-volume up
        else
            wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
            vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2}')
            notify_volume "$vol" "false"
        fi
        ;;
    down)
        if [ "$DEFAULT_SINK" = "$HOMEPOD_SINK" ]; then
            ~/.local/bin/homepod-volume down
        else
            wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
            vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2}')
            notify_volume "$vol" "false"
        fi
        ;;
    mute)
        if [ "$DEFAULT_SINK" = "$HOMEPOD_SINK" ]; then
            ~/.local/bin/homepod-volume mute
        else
            wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
            vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2}')
            muted=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -c MUTED)
            notify_volume "$vol" "$([ "$muted" -gt 0 ] && echo "true" || echo "false")"
        fi
        ;;
    *)
        echo "Usage: $0 {up|down|mute}"
        exit 1
        ;;
esac
