#!/usr/bin/env bash
# Volume keys: real HomePod volume when it is the default sink, system volume otherwise.
# Both paths show the Omarchy OSD (blue bar).

HOMEPOD_SINK="homepod_airplay"

if [ "$(pactl get-default-sink 2>/dev/null)" = "$HOMEPOD_SINK" ]; then
    case "${1:-}" in
        up)   HOMEPOD_NO_NOTIFY=1 ~/.local/bin/homepod-volume up >/dev/null ;;
        down) HOMEPOD_NO_NOTIFY=1 ~/.local/bin/homepod-volume down >/dev/null ;;
        mute) HOMEPOD_NO_NOTIFY=1 ~/.local/bin/homepod-volume mute >/dev/null ;;
        *)    echo "Usage: $0 {up|down|mute}" >&2; exit 1 ;;
    esac
    vol=$(~/.local/bin/homepod-volume get)
    vol=${vol:-0}
    if [ "$vol" -eq 0 ]; then icon=volume-muted; else icon=volume-high; fi
    omarchy-osd -i "$icon" -p "$vol"
else
    case "${1:-}" in
        up)   omarchy-audio-output-volume raise ;;
        down) omarchy-audio-output-volume lower ;;
        mute) omarchy-audio-output-volume mute-toggle ;;
        *)    echo "Usage: $0 {up|down|mute}" >&2; exit 1 ;;
    esac
fi
