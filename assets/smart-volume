#!/usr/bin/env bash
# Fallback volume control (uses Omarchy defaults via swayosd)

DEFAULT_SINK=$(pactl get-default-sink 2>/dev/null | head -1)

notify_volume() {
    swayosd-client --output-volume "$1" 2>/dev/null || true
}

case "${1:-}" in
    up)
        omarchy-audio-output-volume +5
        notify_volume raise
        ;;
    down)
        omarchy-audio-output-volume -5
        notify_volume lower
        ;;
    mute)
        if [ -n "$DEFAULT_SINK" ]; then
            pactl set-sink-mute "$DEFAULT_SINK" toggle
        else
            pactl set-sink-mute @DEFAULT_AUDIO_SINK@ toggle
        fi
        notify_volume mute-toggle
        ;;
    *)
        echo "Usage: $0 {up|down|mute}"
        exit 1
        ;;
esac
