#!/usr/bin/env bash
# HomePod Mini AirPlay Bridge
# Keeps an OwnTone pipe session in sync with activity on the "HomePod Mini" sink.
# PipeWire null sink monitor -> parec -> FIFO -> owntone pipe input -> AirPlay 2.
# On idle->active transition after WAS_IDLE, restarts owntone.service for clean RAOP reconnect.
# Handles iPhone/other device AirPlay takeover by polling HomePod availability.
# Releases AirPlay (deselects output) when PC goes idle so other devices can use HomePod.
# Uses Owntone player progress to detect actual audio (not just stream presence).
# Proactively stops parec on "stop"/"pause" to prevent Broken pipe from Owntone closing pipe.

set -u

SINK="homepod_airplay"
FIFO="$HOME/.local/share/homepod-pipe/homepod.pcm"
OUT_ID="${HOMEPOD_OUTPUT_ID:-148186734507409}"
API="http://localhost:3689/api"
POLL="0.25"
GRACE=2
COOLDOWN=6
SILENCE_TIMEOUT=30
HOMEPOD_IP="${HOMEPOD_IP:-192.168.1.83}"

PAREC_PID=""
IDLE_SINCE=""
LAST_RESTART=0
WAS_IDLE=false
LAST_AVAILABLE_CHECK=0
HOMEPOD_AVAILABLE=true
LAST_PROGRESS=0
LAST_PROGRESS_CHANGE=0
LAST_STATE=""
LAST_RESTART_TIME=0
JUST_STOPPED=false
JUST_STOPPED_TIME=0

log() { echo "[homepod-bridge] $*"; }

player_state() {
    local state
    state=$(curl -sf --max-time 2 "$API/player" 2>/dev/null |
        sed -n 's/.*"state"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p')
    # Fallback: if curl fails or state empty, assume "play" to avoid unwanted restarts
    echo "${state:-play}"
}

player_progress() {
    local progress
    progress=$(curl -sf --max-time 2 "$API/player" 2>/dev/null |
        sed -n 's/.*"item_progress_ms"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
    echo "${progress:-0}"
}

sink_index() {
    pactl list short sinks 2>/dev/null | awk -v s="$SINK" '$2 == s { print $1; exit }'
}

active_streams() {
    local idx
    idx="$(sink_index)"
    [ -z "$idx" ] && { echo 0; return; }
    pactl list sink-inputs 2>/dev/null | awk -v idx="$idx" '
        BEGIN { RS = ""; FS = "\n"; n = 0 }
        {
            s = ""; c = "no"
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^[ \t]*Sink: /)   s = $i
                if ($i ~ /^[ \t]*Corked: /) c = $i
            }
            sub(/.*: /, "", s); sub(/.*: /, "", c)
            if (s == idx && c == "no") n++
        }
        END { print n + 0 }
    '
}

check_homepod_available() {
    local now=$(date +%s)
    if [ $((now - LAST_AVAILABLE_CHECK)) -lt 5 ]; then
        return 0
    fi
    LAST_AVAILABLE_CHECK=$now
    
    if ping -c 1 -W 1 "$HOMEPOD_IP" >/dev/null 2>&1; then
        if [ "$HOMEPOD_AVAILABLE" = false ]; then
            log "HomePod became available again"
            HOMEPOD_AVAILABLE=true
        fi
        return 0
    else
        if [ "$HOMEPOD_AVAILABLE" = true ]; then
            log "HomePod unreachable (may be in use by another device)"
            HOMEPOD_AVAILABLE=false
        fi
        return 1
    fi
}

check_audio_activity() {
    local progress
    progress=$(player_progress)
    local now=$(date +%s)
    
    if [ -n "$progress" ] && [ "$progress" -gt 0 ]; then
        if [ "$progress" -ne "$LAST_PROGRESS" ]; then
            LAST_PROGRESS=$progress
            LAST_PROGRESS_CHANGE=$now
            return 0  # Audio advancing
        elif [ $((now - LAST_PROGRESS_CHANGE)) -ge "$SILENCE_TIMEOUT" ]; then
            return 1  # Progress stuck = silence
        fi
    fi
    return 0  # Can't determine or no progress yet, assume active
}

handle_state_change() {
    local state="$1"
    local now=$(date +%s)
    
    log "handle_state_change: LAST_STATE='$LAST_STATE', current='$state'"
    # If state changed from stop/pause to play, restart session with grace period
    if { [ "$LAST_STATE" = "stop" ] || [ "$LAST_STATE" = "pause" ]; } && [ "$state" = "play" ]; then
        log "state changed from $LAST_STATE to play, restarting session"
        LAST_RESTART_TIME=$(date +%s)
        restart_session
        LAST_STATE="play"
        return
    fi
    # If we just restarted session, ignore immediate pause/stop for 3s
    if [ $((now - LAST_RESTART_TIME)) -lt 3 ] && { [ "$state" = "pause" ] || [ "$state" = "stop" ]; }; then
        log "ignoring pause/stop during restart grace period"
        LAST_STATE="$state"
        return
    fi
    # If state changed from play to stop/pause, proactively stop parec and release AirPlay
    if [ "$LAST_STATE" = "play" ] && { [ "$state" = "stop" ] || [ "$state" = "pause" ]; }; then
        log "state changed from play to $state, proactively stopping parec"
        curl -sf --max-time 2 -o /dev/null -X PUT "$API/player/stop" 2>/dev/null
        stop_parec
        release_airplay
        WAS_IDLE=true
        JUST_STOPPED=true
        JUST_STOPPED_TIME=$(date +%s)
        log "user paused/stopped, session released, AirPlay freed"
    fi
    LAST_STATE="$state"
}

release_airplay() {
    log "releasing AirPlay (deselecting output $OUT_ID)"
    curl -sf --max-time 2 -o /dev/null -X PUT "$API/outputs/$OUT_ID" \
        -H 'Content-Type: application/json' -d '{"selected":false}' 2>/dev/null
}

start_parec() {
    if [ -n "$PAREC_PID" ] && kill -0 "$PAREC_PID" 2>/dev/null; then
        return
    fi
    rm -f "$FIFO"
    mkfifo "$FIFO"
    parec --raw --format=s16le --rate=44100 --channels=2 --device="$SINK.monitor" > "$FIFO" &
    PAREC_PID=$!
    LAST_PROGRESS=0
    LAST_PROGRESS_CHANGE=$(date +%s)
}

stop_parec() {
    if [ -n "$PAREC_PID" ]; then
        kill "$PAREC_PID" 2>/dev/null
        wait "$PAREC_PID" 2>/dev/null
    fi
    PAREC_PID=""
    rm -f "$FIFO"
}

restart_owntone() {
    log "restarting owntone.service to re-establish AirPlay connection"
    systemctl --user restart owntone.service
    for i in {1..30}; do
        if curl -sf --max-time 1 "$API/outputs" >/dev/null 2>&1; then
            sleep 0.5
            return 0
        fi
        sleep 0.2
    done
    log "owntone restart timeout"
    return 1
}

restart_session() {
    LAST_RESTART=$(date +%s)
    if [ "$WAS_IDLE" = true ]; then
        local attempts=0
        while [ $attempts -lt 20 ] && ! check_homepod_available; do
            log "waiting for HomePod to become available... ($attempts/20)"
            sleep 1
            attempts=$((attempts + 1))
        done
        if [ $attempts -eq 20 ]; then
            log "HomePod still unavailable, attempting restart anyway"
        fi
        restart_owntone
        WAS_IDLE=false
    fi
    curl -sf --max-time 2 -o /dev/null -X PUT "$API/player/stop" 2>/dev/null
    start_parec
    sleep 1.5
    curl -sf --max-time 2 -o /dev/null -X PUT "$API/outputs/$OUT_ID" \
        -H 'Content-Type: application/json' -d '{"selected":true}' 2>/dev/null
    # Retry play command up to 5 times with 1s delay
    for i in {1..5}; do
        if curl -sf --max-time 2 -o /dev/null -X PUT "$API/player/play" 2>/dev/null; then
            log "session restarted (play attempt $i succeeded)"
            return 0
        fi
        log "play attempt $i failed, retrying..."
        sleep 1
    done
    log "session restarted (play failed after 5 attempts)"
}

cleanup() {
    stop_parec
    exit 0
}
trap cleanup TERM INT

log "watching sink '$SINK' (HomePod IP: $HOMEPOD_IP, silence timeout: ${SILENCE_TIMEOUT}s via Owntone progress)"

while :; do
    n="$(active_streams)"
    state="$(player_state)"
    now=$(date +%s)

    # Clear JUST_STOPPED flag after grace period
    if [ "$JUST_STOPPED" = "true" ] && [ $((now - JUST_STOPPED_TIME)) -ge 10 ]; then
        JUST_STOPPED=false
    fi

    # Handle state transitions (play -> stop/pause)
    handle_state_change "$state"

    if [ "${n:-0}" -gt 0 ]; then
        IDLE_SINCE=""
        # Check if audio is actually advancing via Owntone progress
        if ! check_audio_activity; then
            log "audio progress stuck for ${SILENCE_TIMEOUT}s, releasing AirPlay"
            curl -sf --max-time 2 -o /dev/null -X PUT "$API/player/stop" 2>/dev/null
            stop_parec
            release_airplay
            WAS_IDLE=true
            log "silence timeout, session released, AirPlay freed"
        elif [ -z "$PAREC_PID" ] || ! kill -0 "$PAREC_PID" 2>/dev/null; then
            # Active streams but no parec -> start session (unless we just stopped)
            if [ "$JUST_STOPPED" = "true" ] && [ $((now - JUST_STOPPED_TIME)) -lt 10 ]; then
                log "active streams but recently stopped, waiting..."
            else
                log "active streams but no parec, restarting session"
                restart_session
            fi
        elif [ "$state" != "play" ] && [ "$state" != "stop" ] && [ "$state" != "pause" ] && [ $((now - LAST_RESTART)) -ge "$COOLDOWN" ]; then
            restart_session
        fi
    else
        [ -z "$IDLE_SINCE" ] && IDLE_SINCE="$now"
        if [ -n "$PAREC_PID" ] && [ $((now - IDLE_SINCE)) -ge "$GRACE" ]; then
            curl -sf --max-time 2 -o /dev/null -X PUT "$API/player/stop" 2>/dev/null
            stop_parec
            release_airplay
            WAS_IDLE=true
            log "idle, session released, AirPlay freed"
        fi
    fi

    sleep "$POLL"
done